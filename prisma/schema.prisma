generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model StoreSettings {
  id                Int         @id @default(autoincrement())
  openAiKey         String
  githubAccessToken String
  selectedRepo      Repository? @relation(fields: [selectedRepoId], references: [id])
  selectedRepoId    String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([selectedRepoId])
}

model Document {
  id           String                   @id @default(cuid())
  content      String
  context      String                   @default("")
  path         String?
  language     String?
  startLine    Int?
  endLine      Int?
  blobSha      String?
  commitSha    String?
  searchVector Unsupported("tsvector")? @default(dbgenerated())
  namespace    String                   @default("default")
  vector       Unsupported("vector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  repository   Repository               @relation(fields: [namespace], references: [id], onDelete: Cascade)

  @@index([namespace])
  @@index([searchVector], type: Gin)
}

model Repository {
  id            String           @id @default(cuid())
  name          String
  url           String           @unique
  status        RepositoryStatus
  error         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  storeSettings StoreSettings[]
  Document      Document[]

  @@index([url])
}

enum RepositoryStatus {
  IMPORTED
  LOADING
  ERROR
  NOT_STARTED
}
